# Optional configuration for the meme API server.
#
# Copy to `.env` and adjust. The server reads it automatically on startup;
# CLI flags always override these values, and any key you omit falls back to
# the built-in default. Point elsewhere with `-env-file <path>` or MEME_ENV_FILE.
#
#   precedence:  CLI flag  >  .env  >  built-in default
#
# These are the same variable names the docker-compose env files use
# (environment/.env.dev, environment/.env.prod), so one vocabulary works
# whether you run the binary directly or via compose.

# Port the API listens on (built-in default: 8080). Flag: -addr :PORT
# Advanced: set ADDR=host:port to bind a specific interface (ADDR wins over PORT).
PORT=8080

# Root dir for emitted framework files (built-in default: OS temp). Flag: -work
WORK=.work

# Run the real solvers instead of dry-run (built-in default: false). Flag: -exec
# Accepts 1/true/yes/on or 0/false/no/off.
EXEC=false

# Require this API key in every request payload (top-level "api_key" field).
# Unset or empty (the default): authentication is disabled — no key is
# required and any key a client sends is accepted. Flag: -api-key
#API_KEY=change-me
