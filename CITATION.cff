    given-names: "Andreas"
    orcid: "https://orcid.org/0009-0004-5418-2847"
    affiliation: "BigGeoData & Spatial AI, Technische Hochschule Deggendorf"
repository-code: "https://github.com/enerplanet/meme"
url: "https://enerplanet.github.io/meme"
license: MIT
keywords:
  - energy system modelling
  - PyPSA
  - Calliope
  - AdOpT-NET0
  - model translation
version: "0.1.0-alpha"
date-released: "2026-10-24"
