# Development environment — unified config.
#
# One vocabulary shared by BOTH docker compose and the meme API binary:
#   * docker compose reads: PORT, HOST_PORT, WORK, EXEC, IMAGE_TAG
#   * the API binary reads:  PORT (or ADDR), WORK, EXEC   (CLI flags override)
#
# Use it either way:
#   make docker-run ENV=dev
#   meme -env-file environment/.env.dev
#
# precedence (API):  CLI flag  >  this file  >  built-in default

# Port the API listens on (container-internal). Promoted to ADDR=:PORT.
PORT=8080

# Host port docker publishes -> container's PORT. (compose only)
HOST_PORT=8080

# Root dir for emitted framework files.
WORK=/src/.work

# Run the real solvers (1/true/yes/on) vs. dry-run (0/false/no/off).
EXEC=true

# Image tag for this environment. (compose only)
IMAGE_TAG=meme-env:dev

# API key required in every request payload ("api_key" field). Empty/absent:
# auth disabled — no key requested, any key accepted. (API only)
#API_KEY=change-me
