# Production environment — unified config.
#
# Same variable vocabulary as .env.dev; read by both docker compose and the
# meme API binary. See .env.dev for the full explanation.
#
#   make -C environment run ENV=prod

# Port the API listens on (container-internal). Promoted to ADDR=:PORT.
PORT=8080

# Publish on the standard HTTP port; container still listens on PORT. (compose only)
HOST_PORT=80

# Root dir for emitted framework files.
WORK=/src/.work

# Run the real solvers (1/true/yes/on) vs. dry-run (0/false/no/off).
EXEC=true

# Image tag for this environment. (compose only)
IMAGE_TAG=meme-env:prod

# API key required in every request payload ("api_key" field). Empty/absent:
# auth disabled — no key requested, any key accepted. (API only)
#API_KEY=change-me

# Browser origins allowed via CORS, comma-separated ("*" and
# https://*.sub wildcards work). Empty/absent: CORS disabled. (API only)
#CORS_ORIGINS=https://app.example.com
