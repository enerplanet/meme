    },
    "time": {
      "start": "2025-01-01T00:00:00",
      "end": "2025-01-01T03:00:00",
      "resolution": "1H"
    },
    "carriers": {
      "electricity": {
        "unit": "MWh"
      }
    },
    "nodes": {
