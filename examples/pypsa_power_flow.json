        "demand_profile": "dem1"
      },
      "load2": {
        "role": "demand",
        "node": "mv2",
        "carrier_in": "electricity",
        "demand_profile": "dem2"
      },
      "battery": {
        "role": "storage",
        "node": "mv1",
        "carrier_out": "electricity",
        "capacity": {
          "existing": 4
        },
        "storage": {
          "max_hours": 2,
          "charge_eff": 0.95,
          "discharge_eff": 0.95
        },
        "dispatch": "batt_out"
      }
    },
    "timeseries": {
      "pv_out": {
        "source": "inline",
        "values": [
          0,
          2,
          6,
          8
        ]
      },
      "dem1": {
        "source": "inline",
        "values": [
          10,
          12,
          14,
          11
        ]
      },
      "dem2": {
        "source": "inline",
        "values": [
          6,
          7,
          8,
          6
        ]
      },
      "batt_out": {
        "source": "inline",
        "values": [
          2,
          1,
          -1,
          -2
        ]
      }
    },
    "transmission": {
      "trafo": {
        "carrier": "electricity",
        "from": "hv",
        "to": "mv1",
        "bidirectional": true,
