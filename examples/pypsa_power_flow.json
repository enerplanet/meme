        "coords": {
          "lat": 48.0,
          "lon": 11.0
        },
        "electrical": {
          "v_nom": 110
        }
      },
      "mv1": {
        "coords": {
          "lat": 48.1,
          "lon": 11.1
        },
        "electrical": {
          "v_nom": 20
        }
      },
      "mv2": {
        "coords": {
          "lat": 48.2,
          "lon": 11.2
        },
        "electrical": {
          "v_nom": 20
        }
      }
    },
    "technologies": {
