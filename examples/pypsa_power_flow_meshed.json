        },
        "distance": 10,
        "electrical": {
          "kind": "line",
          "r": 1.2,
          "x": 3.5,
          "s_nom": 20
        }
      },
      "l23": {
        "carrier": "electricity",
        "from": "mv2",
        "to": "mv3",
        "bidirectional": true,
        "capacity": {
          "existing": 15
        },
        "distance": 6,
        "electrical": {
          "kind": "line",
          "r": 0.7,
          "x": 2.1,
          "s_nom": 15
        }
      }
    }
