{
  "api_key": "s3cret",
  "model": {
    "metadata": {
      "name": "pypsa_power_flow_meshed",
      "description": "A meshed 20 kV ring under an HV transformer: one PV technology at two nodes with a dispatch series per node, one load technology at three nodes with a per-node profile, two parallel transformers with a tap ratio, the slack spelled tech@node, a tight tolerance."
    },
    "time": {
      "start": "2025-01-01T00:00:00",
      "end": "2025-01-01T03:00:00",
      "resolution": "1H"
    },
    "carriers": {
      "electricity": {
        "unit": "MWh"
      }
    },
    "nodes": {
      "hv": {
        "coords": {
          "lat": 48.0,
          "lon": 11.0
        },
        "electrical": {
          "v_nom": 110
        }
      },
      "mv1": {
        "coords": {
          "lat": 48.1,
          "lon": 11.1
        },
        "electrical": {
          "v_nom": 20
        }
      },
      "mv2": {
        "coords": {
          "lat": 48.2,
          "lon": 11.2
        },
        "electrical": {
          "v_nom": 20
        }
      },
      "mv3": {
        "coords": {
          "lat": 48.1,
          "lon": 11.3
        },
        "electrical": {
          "v_nom": 20
        }
      }
    },
    "technologies": {
      "grid": {
        "role": "supply",
        "node": "hv",
        "carrier_out": "electricity",
        "capacity": {
          "existing": 100
        }
      },
      "pv": {
        "role": "supply",
        "node": [
          "mv2",
          "mv3"
        ],
        "carrier_out": "electricity",
        "capacity": {
          "existing": 10
        },
        "dispatch": "pv_mv2",
        "node_overrides": {
          "mv3": {
            "dispatch": "pv_mv3"
          }
        }
      },
      "load": {
        "role": "demand",
        "node": [
          "mv1",
          "mv2",
          "mv3"
        ],
        "carrier_in": "electricity",
        "demand_profile": "dem",
        "node_overrides": {
          "mv3": {
            "demand_profile": "dem_mv3"
          }
        }
      }
    },
    "timeseries": {
      "pv_mv2": {
        "source": "inline",
        "values": [
          0,
          2,
          6,
          8
        ]
      },
      "pv_mv3": {
        "source": "inline",
        "values": [
          0,
          3,
          7,
          9
        ]
      },
      "dem": {
        "source": "inline",
        "values": [
          10,
          12,
          14,
          11
        ]
      },
      "dem_mv3": {
        "source": "inline",
        "values": [
          15,
          16,
          18,
          14
        ]
      }
    },
    "transmission": {
      "trafo": {
        "carrier": "electricity",
        "from": "hv",
        "to": "mv1",
        "bidirectional": true,
        "capacity": {
          "existing": 80
        },
        "electrical": {
          "kind": "transformer",
          "r": 0.01,
          "x": 0.1,
          "s_nom": 60,
          "num_parallel": 2,
          "tap_ratio": 1.0
        }
      },
      "l12": {
        "carrier": "electricity",
