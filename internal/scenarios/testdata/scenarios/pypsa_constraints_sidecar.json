{
  "model": {
    "metadata": {"name": "pypsa_constraints_sidecar"},
    "time": {"start": "2025-01-01", "end": "2025-01-02", "resolution": "1H"},
    "carriers": {"electricity": {"unit": "MWh"}},
    "nodes": {"n1": {}},
    "technologies": {
      "pv": {"role": "supply", "node": "n1", "carrier_out": "electricity",
             "capacity": {"expandable": true, "max": 1000}, "lifetime": 25, "interest_rate": 0.05,
             "costs": {"monetary": {"investment_per_capacity": 500000, "variable_om": 0}}},
      "gas": {"role": "supply", "node": "n1", "carrier_out": "electricity",
              "capacity": {"existing": 500, "expandable": false},
              "costs": {"monetary": {"variable_om": 5}}},
      "load": {"role": "demand", "node": "n1", "carrier_in": "electricity", "demand_profile": 100}
    },
    "constraints": [{"name": "force_pv", "sense": ">=", "bound": 300,
                     "terms": [{"coefficient": 1, "variable": "capacity", "techs": ["pv"]}]}]
  },
  "experiment": {"mode": "plan", "solver": {"name": "highs"}}
}
